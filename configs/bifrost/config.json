{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": true,
    "disable_content_logging": false,
    "drop_excess_requests": false,
    "initial_pool_size": 300
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./data/logs.db"
    }
  },
  "vector_store": {
    "enabled": false,
    "type": "qdrant",
    "config": {
      "host": "localhost",
      "port": 6334
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "bifrost",
        "collector_url": "otel-collector-agent:4317",
        "trace_type": "genai_extension",
        "protocol": "grpc",
        "insecure": true,
        "metrics_enabled": true,
        "metrics_endpoint": "otel-collector-agent:4317",
        "metrics_push_interval": 15
      }
    }
  ],
  "providers": {
    "lgos": {
      "keys": [],
      "network_config": {
        "base_url": "http://192.168.2.21:8000",
        "allow_private_network": true
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "is_key_less": true,
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "passthrough": true,
          "passthrough_stream": true
        }
      }
    }
  }
}
