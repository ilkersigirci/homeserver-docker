{
  "ipp": {
    "responseHeaders": {
      "Cache-Control": "public, max-age=2592000",
      "Access-Control-Allow-Origin": "*"
    },
    "maxDownloadQuality": "original",
    "downloadedFilename": 0,
    "allowDownload": 0,
    "downloadFromImmichConcurrencyLimit": 20,
    "allowSlugLinks": true,
    "showHomePage": true,
    "showMetadata": {
      "description": {
        "caption": false,
        "sidebar": false
      }
    },
    "customInvalidResponse": false,
    "gallery": {
      "singleImage": false,
      "singleItemAutoOpen": true,
      "showTitle": true,
      "showDescription": false,
      "groupByDate": false
    },
    "lightbox": {
      "showArrows": true,
      "showDownload": true,
      "mobileArrows": false
    }
  }
}
