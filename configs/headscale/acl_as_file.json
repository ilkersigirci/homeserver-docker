{
  "$schema": "./tailscale-acl.json-schema.json",
  "groups": {
    "group:admin": ["ilker@"]
  },
  "tagOwners": {
    "tag:ilker": ["group:admin"]
  },
  "hosts": {},
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"]
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["ilker", "ubuntu", "root"]
    }
  ]
}
