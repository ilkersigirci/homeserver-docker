                    "url": "/d/lgos-e2e-otel/lgos-e2e-opentelemetry?orgId=1&var-trace_id=${__value.raw}&from=${__from}&to=${__to}"
                  },
                  {
                    "targetBlank": true,
                    "title": "Open in Langfuse",
