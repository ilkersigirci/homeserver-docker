      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(increase(bifrost_success_requests_total{provider=~\"$provider\",model=~\"$model\",method=~\"$method\"}[$__range])) / clamp_min(sum(increase(bifrost_upstream_requests_total{provider=~\"$provider\",model=~\"$model\",method=~\"$method\"}[$__range])), 1)",
          "legendFormat": "Success Rate",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Average Latency",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * (sum(increase(bifrost_upstream_latency_seconds_sum{provider=~\"$provider\",model=~\"$model\",method=~\"$method\"}[$__range])) / clamp_min(sum(increase(bifrost_upstream_latency_seconds_count{provider=~\"$provider\",model=~\"$model\",method=~\"$method\"}[$__range])), 1e-9))",
          "legendFormat": "Avg Latency",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1500
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      }
    },
