    {
      "id": 9,
      "title": "Hourly Spend by Provider / Model",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (provider, model) (sum_over_time(bifrost:cost_usd_delta_5m:by_provider_model_method{host_name!=\"\",host_name=~`${host:regex}`,provider=~`${provider:regex}`,model=~`${model:regex}`,method=~`${method:regex}`}[1h])))",
          "legendFormat": "{{provider}} / {{model}}",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.3.0",
      "description": "Trailing one-hour spend, split by provider and model."
