      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 50,
          "query": "{ resource.service.namespace = \"lgos\" && resource.deployment.environment.name = \"$environment\" && resource.host.name =~ \"$host\" && resource.service.name = \"lgos-litellm\" && span.gen_ai.operation.name =~ \"$operation\" } | select(span.gen_ai.operation.name, span.gen_ai.provider.name, span.gen_ai.request.model, span.gen_ai.usage.input_tokens, span.gen_ai.usage.output_tokens, span.litellm.cost.total, span.error.type) with (most_recent=true)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "transformations": [
