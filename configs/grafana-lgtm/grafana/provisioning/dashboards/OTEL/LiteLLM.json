          "expr": "round(sum(increase(gen_ai_client_operation_duration_seconds_count{service_name=\"lgos-litellm\",service_namespace=\"lgos\",deployment_environment_name=\"$environment\",host_name=~\"$host\",gen_ai_operation_name=~\"$operation\",error_type!=\"\"}[$__range]))) or vector(0)",
