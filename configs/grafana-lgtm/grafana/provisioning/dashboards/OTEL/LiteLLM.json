      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "round(sum(increase(gen_ai_client_operation_duration_seconds_count{service_name=\"lgos-litellm\",service_namespace=\"lgos\",deployment_environment_name=\"$environment\",host_name=~\"$host\",gen_ai_operation_name=~\"$operation\"}[$__range]))) or vector(0)",
