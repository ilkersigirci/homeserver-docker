      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{service_name=\"lgos-litellm\",service_namespace=\"lgos\",deployment_environment_name=\"$environment\",host_name=~\"$host\",gen_ai_operation_name=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "Operation median",
