+    def to_conversation(self) -> tuple[str, list[tuple[str, str]], str]:
+        """Split input into caller instructions, earlier turns, and the current user message.
+
+        File references are passed separately in the run context.
+        """
+        items = [{"role": "user", "content": self.input}] if isinstance(self.input, str) else self.input
+        instructions = [self.instructions or ""]
+        turns = []
+        for item in items:
+            if not isinstance(item, dict) or "role" not in item:
+                msg = "Only message items are supported in Responses input arrays"
+                raise ValueError(msg)
+            role = str(item["role"]).lower()
+            if role not in {"developer", "system", "user", "assistant"}:
+                msg = f"Unsupported message role: {role}"
+                raise ValueError(msg)
+            text = _input_content_text(item.get("content"))
+            if role in {"developer", "system"}:
+                instructions.append(text)
+            else:
+                turns.append((role, text))
+
+        if not turns or turns[-1][0] != "user":
+            msg = "Input must end with a user message"
+            raise ValueError(msg)
+        return "\n\n".join(filter(None, instructions)), turns[:-1], turns[-1][1]
+
+
+def _input_content_text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        msg = "Only text and file-ID message content is supported"
+        raise ValueError(msg)
+
+    text_parts = []
+    for part in content:
+        if isinstance(part, str):
+            text_parts.append(part)
+        elif (
+            isinstance(part, dict)
+            and part.get("type") in {"input_text", "output_text", "text"}
+            and isinstance(part.get("text"), str)
+        ):
+            text_parts.append(part["text"])
+        elif isinstance(part, dict) and part.get("type") == "input_file":
+            file_id = part.get("file_id")
+            if (
+                not isinstance(file_id, str)
+                or not file_id.strip()
+                or part.get("file_data") is not None
+                or part.get("file_url") is not None
+            ):
+                msg = "File inputs require a non-empty file_id; file_data and file_url are not supported"
+                raise ValueError(msg)
+        else:
+            content_type = part.get("type", "unknown") if isinstance(part, dict) else "unknown"
+            msg = f"Unsupported message content type: {content_type}"
+            raise ValueError(msg)
+    return "\n".join(text_parts)
+

