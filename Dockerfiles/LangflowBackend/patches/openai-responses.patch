+async def openai_api_key_security(request: Request) -> UserRead | None:
+    """Accept Langflow's x-api-key or the OpenAI-standard bearer token."""
+    query_key = request.query_params.get("x-api-key")
+    header_key = request.headers.get("x-api-key")
+    if not query_key and not header_key:
+        scheme, credentials = get_authorization_scheme_param(request.headers.get("authorization"))
+        if scheme.lower() == "bearer":
+            header_key = credentials
+    return await api_key_security(query_key, header_key)
