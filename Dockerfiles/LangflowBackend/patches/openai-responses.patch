+    def to_input_text(self) -> str:
+        """Flatten supported Responses input into the text accepted by ChatInput."""
+        if isinstance(self.input, str):
+            messages = [("user", self.input)]
+        else:
+            messages = []
+            for item in self.input:
+                if not isinstance(item, dict) or "role" not in item:
+                    msg = "Only message items are supported in Responses input arrays"
+                    raise ValueError(msg)
+                role = str(item["role"]).lower()
+                if role not in {"developer", "system", "user", "assistant"}:
+                    msg = f"Unsupported message role: {role}"
+                    raise ValueError(msg)
+                messages.append((role, _input_content_text(item.get("content"))))
+
+        if self.instructions:
+            messages.insert(0, ("system", self.instructions))
+        if not messages:
+            msg = "At least one input message is required"
+            raise ValueError(msg)
+        if len(messages) == 1 and messages[0][0] == "user":
+            return messages[0][1]
+        return "\n\n".join(f"{role.upper()}: {content}" for role, content in messages)
+
+
+def _input_content_text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if not isinstance(content, list):
+        msg = "Only text message content is supported"
+        raise ValueError(msg)
+
+    text_parts = []
+    for part in content:
+        if isinstance(part, str):
+            text_parts.append(part)
+        elif (
+            isinstance(part, dict)
+            and part.get("type") in {"input_text", "output_text", "text"}
+            and isinstance(part.get("text"), str)
+        ):
+            text_parts.append(part["text"])
+        else:
+            content_type = part.get("type", "unknown") if isinstance(part, dict) else "unknown"
+            msg = f"Unsupported message content type: {content_type}"
+            raise ValueError(msg)
+    return "\n".join(text_parts)
+

 class OpenAIResponsesResponse(BaseModel):
     """OpenAI-compatible responses response."""
