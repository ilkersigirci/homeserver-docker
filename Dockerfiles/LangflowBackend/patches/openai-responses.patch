+            sender_name=MESSAGE_SENDER_NAME_USER if role == "user" else MESSAGE_SENDER_NAME_AI,
+            session_id=session_id,
+            # Chat memory orders by timestamp alone.
+            timestamp=start + timedelta(microseconds=index),
+        )
+        for index, (role, text) in enumerate(history)
+        # File-only turns have no text; their IDs stay in the run context.
+        if text
+    ]
+    if not messages:
