+_AUTH_PROVIDER_STATE = "_litellm_auth_provider"
+_CUSTOM_AUTH_PROVIDER = "custom"
+_NATIVE_AUTH_PROVIDER = "native"
+_INGRESS_AUTH_LANE_HEADER = "X-LiteLLM-Auth-Lane"
+_LIVELINESS_ROUTE = ("GET", "/health/liveliness")
+
+
+def _should_run_user_custom_auth(
+    request: Request,
+    user_custom_auth: Callable | None,
+) -> bool:
+    if user_custom_auth is None:
+        return False
+
+    lane = request.headers.get(_INGRESS_AUTH_LANE_HEADER)
+    provider = (
+        _CUSTOM_AUTH_PROVIDER
+        if lane is None and (request.method, request.url.path) == _LIVELINESS_ROUTE
+        else lane.strip().casefold()
+        if lane is not None
+        else None
+    )
+    if provider is None:
+        raise ProxyException(
+            message="Trusted authentication lane is missing",
+            type=ProxyErrorTypes.auth_error,
+            param=_INGRESS_AUTH_LANE_HEADER,
+            code=status.HTTP_401_UNAUTHORIZED,
+        )
+
+    if provider not in {_CUSTOM_AUTH_PROVIDER, _NATIVE_AUTH_PROVIDER}:
+        raise ProxyException(
+            message="Trusted authentication lane must be custom or native",
+            type=ProxyErrorTypes.auth_error,
+            param=_INGRESS_AUTH_LANE_HEADER,
+            code=status.HTTP_400_BAD_REQUEST,
+        )
+
+    setattr(request.state, _AUTH_PROVIDER_STATE, provider)
+    return provider == _CUSTOM_AUTH_PROVIDER
+
+
+def _request_used_user_custom_auth(request: Request) -> bool:
+    return getattr(request.state, _AUTH_PROVIDER_STATE, None) == _CUSTOM_AUTH_PROVIDER
+
+
+def _require_custom_auth_common_checks(
+    request: Request,
+    general_settings: dict[str, Any],
+) -> None:
+    if (
+        _request_used_user_custom_auth(request=request)
+        and general_settings.get("custom_auth_run_common_checks") is not True
+    ):
+        raise ProxyException(
+            message=(
+                "Delegated authentication requires "
+                "general_settings.custom_auth_run_common_checks: true"
+            ),
+            type=ProxyErrorTypes.internal_server_error,
+            param="custom_auth_run_common_checks",
+            code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+        )
+
+    if (
+        _request_used_user_custom_auth(request=request)
+        and getattr(litellm, "enable_post_custom_auth_checks", False) is not True
+    ):
+        raise ProxyException(
+            message=(
+                "Delegated authentication requires "
+                "litellm_settings.enable_post_custom_auth_checks: true"
+            ),
+            type=ProxyErrorTypes.internal_server_error,
+            param="enable_post_custom_auth_checks",
+            code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+        )
+

