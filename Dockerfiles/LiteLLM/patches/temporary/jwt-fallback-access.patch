         jwt_handler,
         litellm_proxy_admin_name,
+        llm_model_list,
         llm_router,
         master_key,
         model_max_budget_limiter,
@@ -1810,6 +1811,17 @@
                             valid_token = auto_registered
                             api_key = valid_token.token or ""

+                    # Same as the virtual-key path: common_checks covers only the primary
+                    # model, so authorize client-supplied fallbacks here too.
