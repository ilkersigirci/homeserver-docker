+def apply_files_provider_config(data: dict, custom_llm_provider: str) -> None:
+    """Send a provider-only file call to the provider's files_settings entry, the
+    backend create_file uploads to. Without files_settings, data is unchanged."""
+    if files_config is None:
+        return
+    llm_provider_config: Final = get_files_provider_config(custom_llm_provider=custom_llm_provider)
+    if llm_provider_config is not None:
+        data.update({key: value for key, value in llm_provider_config.items() if key != "custom_llm_provider"})
+
