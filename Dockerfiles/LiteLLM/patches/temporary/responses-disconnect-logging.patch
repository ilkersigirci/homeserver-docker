+async def _log_cancelled_responses_stream(
+    request_data: dict,
+    response: object,
+    output_text_deltas: Sequence[OutputTextDeltaEvent],
+    user_api_key_dict: UserAPIKeyAuth,
+    proxy_logging_obj: ProxyLogging,
+) -> bool:
+    """
+    Responses streams have no Chat chunks for partial billing, so record the
+    disconnect as a 499 failure. The proxy failure hook persists it, releases the
+    request slot, and pops the logging object, so this runs at most once; returns
+    True when it ran. Final usage is unknown without a terminal event, so the
+    logged snapshot carries only the delivered text.
+    """
+    logging_obj: Final = request_data.get("litellm_logging_obj")
+    if (
+        litellm.disable_streaming_logging is True
+        or not isinstance(response, BaseResponsesAPIStreamingIterator)
+        or not isinstance(logging_obj, LiteLLMLoggingObj)
+        or response.completed_response is not None
+    ):
+        return False
+    if output_text_deltas:
+        logging_obj.model_call_details["partial_response"] = {
+            "object": "response",
+            "status": "cancelled",
+            "output": [
+                {
+                    "id": item_id,
+                    "type": "message",
+                    "role": "assistant",
+                    "status": "incomplete",
+                    "content": [
+                        {"type": "output_text", "text": "".join(delta.delta for delta in part), "annotations": []}
+                        for _, part in groupby(item_deltas, key=attrgetter("content_index"))
+                    ],
+                }
+                for item_id, item_deltas in groupby(output_text_deltas, key=attrgetter("item_id"))
+            ],
+            "usage": None,
+        }
+    exception: Final = litellm.APIError(
+        status_code=LITELLM_HTTP_STATUS_CLIENT_DISCONNECTED,
+        message=_CLIENT_DISCONNECTED_ERROR_INFORMATION["error_message"],
+        llm_provider=response.custom_llm_provider or "",
+        model=response.model or "",
+    )
+    await logging_obj.dispatch_failure_handlers(exception, traceback_exception="", prefer_async_handlers=True)
+    await proxy_logging_obj.post_call_failure_hook(
+        request_data=request_data,
+        original_exception=exception,
+        user_api_key_dict=user_api_key_dict,
+    )
+    return True
+
