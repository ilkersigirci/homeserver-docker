+
+    async def _stream_get_response(
+        self,
+        *,
+        async_httpx_client: AsyncHTTPHandler,
+        url: str,
+        headers: dict,
+        params: dict,
+        timeout: float | httpx.Timeout | None,
+        responses_api_provider_config: BaseResponsesAPIConfig,
+        logging_obj: LiteLLMLoggingObj,
+        custom_llm_provider: str | None,
+        litellm_metadata: dict[str, object] | None,
+    ) -> ResponsesAPIStreamingIterator:
+        """Stream a stored response's events, which the create request already billed."""
+        request: Final = async_httpx_client.client.build_request(
+            "GET",
+            url,
+            headers=headers,
+            params=params,
+            timeout=timeout if timeout is not None else httpx.USE_CLIENT_DEFAULT,
+        )
+        response: Final = await async_httpx_client.client.send(request, stream=True)
+        try:
+            response.raise_for_status()
+        except Exception as e:
+            await response.aread()
+            await response.aclose()
+            raise self._handle_error(
+                e=e,
+                provider_config=responses_api_provider_config,
+            )
+        iterator: Final = ResponsesAPIStreamingIterator(
+            response=response,
+            model="",
+            logging_obj=logging_obj,
+            responses_api_provider_config=responses_api_provider_config,
+            litellm_metadata=litellm_metadata,
+            custom_llm_provider=custom_llm_provider,
+            call_type=CallTypes.responses.value,
+        )
+        iterator._completed_response_logged = True
+        return iterator

