Upstream bug: Responses WebSocket first-frame authorization skips the
Internal User's per-model budget that HTTP requests enforce.

Check the user's per-model budget once the first frame names the model;
zero-cost models stay exempt, as on HTTP.

Removal check: WebSocket budget check in tests/verify_user_auth.py

diff --git a/litellm/proxy/response_api_endpoints/endpoints.py b/litellm/proxy/response_api_endpoints/endpoints.py
--- a/litellm/proxy/response_api_endpoints/endpoints.py
+++ b/litellm/proxy/response_api_endpoints/endpoints.py
@@ -1377,7 +1377,9 @@
     user_api_key_dict: UserAPIKeyAuth,
     llm_router: "Router | None",
 ) -> None:
+    from litellm.proxy.auth.auth_checks import _is_model_cost_zero
     from litellm.proxy.auth.user_api_key_auth import (
+        _check_user_model_budget,
         _enforce_key_and_fallback_model_access,
         _run_centralized_common_checks,
     )
@@ -1385,6 +1387,7 @@
         general_settings,
         llm_model_list,
         master_key,
+        model_max_budget_limiter,
         user_custom_auth,
     )

@@ -1406,6 +1409,13 @@
         llm_model_list=llm_model_list,
         llm_router=llm_router,
     )
+    # The handshake loaded the user's per-model budgets before the model was known.
