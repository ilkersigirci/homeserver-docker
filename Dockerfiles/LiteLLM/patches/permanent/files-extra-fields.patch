+# The proxy's own upload, routing, and logging fields. Every other form field and query
+# parameter, list pagination included, belongs to the files backend.
+_FILE_PROXY_FIELDS: Final = frozenset({
+    "file", "purpose", "expires_after", "provider", "custom_llm_provider", "model",
+    "target_model_names", "target_storage", "passthrough", "litellm_metadata",
+})
+
+
+def _file_backend_fields(fields: ImmutableMultiDict) -> dict[str, Any]:
+    """The text fields that are not the proxy's own, as the OpenAI SDK's extra_body or extra_query.
+
+    The SDK encodes objects as key[sub] and arrays as key[]. Keys pass through as sent, but
+    key[] becomes key with a list, so the provider SDK sends key[] again, not key[][].
+    A repeated plain key keeps its last value, as FastAPI reads it.
+    """
+    backend_fields: dict[str, Any] = {}
+    for key in fields:
+        values = [value for value in fields.getlist(key) if isinstance(value, str)]
+        if values and key.split("[", 1)[0] not in _FILE_PROXY_FIELDS:
+            backend_fields[key.removesuffix("[]")] = values if key.endswith("[]") else values[-1]
+    return backend_fields
+
+
