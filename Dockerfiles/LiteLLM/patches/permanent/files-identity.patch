+FILES_IDENTITY_FIELDS: Final = ("user_api_key_user_id", "user_api_key_team_id", "user_api_key_auth_metadata")
+
+
+def add_user_information_headers(data: dict, user_api_key_dict: UserAPIKeyAuth, custom_llm_provider: str) -> None:
+    """Tell the provider's files_settings backend who is calling: the key's user_id, team_id and
+    metadata, from the sanitized key details add_user_information_to_llm_headers sends, named and
+    encoded as it does. Only these three go, built from the authenticated key alone.
+
+    Call it after every other merge into data: a header of these names from any other source is
+    dropped, so only the authenticated key can supply one. The dict is rebuilt, never changed in
+    place, because it can be the shared files_settings entry's own.
+    Without a files_settings entry for the provider, data is unchanged."""
+    if files_config is None or get_files_provider_config(custom_llm_provider=custom_llm_provider) is None:
+        return
+    key: Final = LiteLLMProxyRequestSetup.get_sanitized_user_information_from_key(user_api_key_dict=user_api_key_dict)
+    data["extra_headers"] = {
+        **{
+            name: value
+            for name, value in (data.get("extra_headers") or {}).items()
+            if not name.lower().startswith("x-litellm-user_api_key_")
+        },
+        **{
+            f"x-litellm-{field}": json.dumps(value) if isinstance(value, dict) else str(value)
+            for field in FILES_IDENTITY_FIELDS
+            if (value := key.get(field)) is not None
+        },
+    }
+
+
