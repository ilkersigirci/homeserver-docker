+def _inject_provider_trace_context(span: Span, kwargs: Mapping[str, Any]) -> None:
+    """Make the provider request a child of LiteLLM's LLM-call span."""
+    if not litellm.forward_traceparent_to_llm_provider:
+        return
+    additional_args: Final = kwargs.get("additional_args")
+    if not isinstance(additional_args, Mapping):
+        return
+    headers: Final = additional_args.get("headers")
+    if not isinstance(headers, MutableMapping):
+        return
+
+    carrier: dict[str, str] = {}
+    _TRACE_CONTEXT_PROPAGATOR.inject(
+        carrier,
+        context=set_span_in_context(span),
+    )
+    headers.update(carrier)
+
