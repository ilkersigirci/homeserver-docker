Upstream gap: Open WebUI calls a manifold Pipe's pipes() without the user, so
the Pipe can only list its models with one shared credential.

Pass pipes() the user's OAuth token when it declares __oauth_token__, as pipe()
receives it.

Removal check: an Open WebUI release that gives pipes() the user's OAuth token.

--- a/open_webui/functions.py
+++ b/open_webui/functions.py
@@ -68,7 +68,16 @@
     return function_module


-async def get_function_models(request):
+async def get_pipes_params(request, user, pipes) -> dict:
+    """Give a manifold's pipes() the user's OAuth token, as pipe() receives it."""
+    if user is None or '__oauth_token__' not in inspect.signature(pipes).parameters:
+        return {}
+    from open_webui.utils.middleware import get_system_oauth_token
+
+    return {'__oauth_token__': await get_system_oauth_token(request, user)}
+
+
+async def get_function_models(request, user=None):
     if not ENABLE_PLUGINS:
         return []

@@ -90,10 +99,11 @@
                 # Handle pipes being a list, sync function, or async function
                 try:
                     if callable(function_module.pipes):
+                        params = await get_pipes_params(request, user, function_module.pipes)
                         if asyncio.iscoroutinefunction(function_module.pipes):
-                            sub_pipes = await function_module.pipes()
+                            sub_pipes = await function_module.pipes(**params)
                         else:
-                            sub_pipes = function_module.pipes()
+                            sub_pipes = function_module.pipes(**params)
                     else:
                         sub_pipes = function_module.pipes
                 except Exception as e:
