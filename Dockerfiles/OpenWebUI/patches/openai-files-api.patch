+"""Chat documents in an OpenAI-compatible Files API (homeserver openai-files-api.patch).
+
+A model matching OPENAI_FILES_API_MODELS_REGEX_PATTERN receives each user message's
+documents as standard file parts, and CONTENT_EXTRACTION_ENGINE=openai_files reads a
+document's extracted text from the Files API. A file is uploaded once; its meta keeps
+the Files API ID for later requests.
+"""
+
+import asyncio
+import logging
+import os
+import re
+
+import aiofiles
+import aiohttp
+from open_webui.env import AIOHTTP_CLIENT_SESSION_SSL, AIOHTTP_FILE_STREAM_CHUNK_SIZE, ENABLE_FORWARD_USER_INFO_HEADERS
+from open_webui.models.files import Files
+from open_webui.storage.provider import Storage
+from open_webui.utils.access_control.files import has_access_to_file
+from open_webui.utils.headers import include_user_info_headers
+from open_webui.utils.json_codec import JSONCodec
+from open_webui.utils.misc import is_raster_image_content_type
+from open_webui.utils.session_pool import get_session
+
+log = logging.getLogger(__name__)
+
+ENABLE_OPENAI_FILES_API = os.getenv('ENABLE_OPENAI_FILES_API', 'false').lower() == 'true'
+OPENAI_FILES_API_BASE_URL = os.getenv('OPENAI_FILES_API_BASE_URL', '').rstrip('/')
+OPENAI_FILES_API_KEY = os.getenv('OPENAI_FILES_API_KEY', '')
+try:
+    OPENAI_FILES_API_PARAMS = JSONCodec.loads(os.getenv('OPENAI_FILES_API_PARAMS') or '{}')
+    if not isinstance(OPENAI_FILES_API_PARAMS, dict):
+        raise ValueError('expected a JSON object')
+except Exception as e:
+    log.exception(f'Error loading OPENAI_FILES_API_PARAMS: {e}')
+    OPENAI_FILES_API_PARAMS = {}
+try:
+    OPENAI_FILES_API_TIMEOUT = int(os.getenv('OPENAI_FILES_API_TIMEOUT') or 300)
+except ValueError:
+    OPENAI_FILES_API_TIMEOUT = 300
+# Compiled once. Unset or invalid, it matches nothing ('(?!)'), so a bad pattern turns
+# file IDs off instead of failing every chat.
+try:
+    OPENAI_FILES_API_MODELS_REGEX = re.compile(os.getenv('OPENAI_FILES_API_MODELS_REGEX_PATTERN') or '(?!)')
+except re.error as e:
+    log.exception(f'Error compiling OPENAI_FILES_API_MODELS_REGEX_PATTERN: {e}')
+    OPENAI_FILES_API_MODELS_REGEX = re.compile('(?!)')
+
+
+def is_enabled() -> bool:
+    return ENABLE_OPENAI_FILES_API and bool(OPENAI_FILES_API_BASE_URL)
+
+
+def is_file_id_model(model: dict) -> bool:
+    """The model, or a workspace model's base model, reads documents by Files API file ID."""
+    model_ids = (model.get('id'), (model.get('info') or {}).get('base_model_id'))
+    return is_enabled() and any(OPENAI_FILES_API_MODELS_REGEX.match(model_id) for model_id in model_ids if model_id)
+
+
+async def get_request_headers(request, user) -> dict[str, str]:
+    """Authenticate like the OpenAI connection with the Files API base URL."""
+    # Defined by speech-images-system-oauth.patch.
+    from open_webui.routers.openai import get_connection_api_key
+
+    api_key = await get_connection_api_key(request, user, OPENAI_FILES_API_BASE_URL, OPENAI_FILES_API_KEY)
+    headers = {'Authorization': f'Bearer {api_key}'}
+    if user and ENABLE_FORWARD_USER_INFO_HEADERS:
+        headers = include_user_info_headers(headers, user)
+    return headers
+
+
+async def get_openai_file_id(request, user, file) -> str:
+    """Return the file's Files API ID, uploading the file on first use."""
+    file_id = (file.meta or {}).get('openai_file_id')
+    if file_id:
+        return file_id
+
+    file_path = await asyncio.to_thread(Storage.get_file, file.path)
+
+    async def file_chunks():
+        async with aiofiles.open(file_path, 'rb') as f:
+            while chunk := await f.read(AIOHTTP_FILE_STREAM_CHUNK_SIZE):
+                yield chunk
+
+    # By default aiohttp percent-encodes the filename, and servers keep it encoded.
+    form_data = aiohttp.FormData(quote_fields=False)
+    form_data.add_field('purpose', 'user_data')
+    form_data.add_field(
+        'file',
+        file_chunks(),
+        filename=file.filename,
+        content_type=(file.meta or {}).get('content_type') or 'application/octet-stream',
+    )
+    session = await get_session()
+    async with session.post(
+        f'{OPENAI_FILES_API_BASE_URL}/files',
+        params=OPENAI_FILES_API_PARAMS,
+        data=form_data,
+        headers=await get_request_headers(request, user),
+        ssl=AIOHTTP_CLIENT_SESSION_SSL,
+        timeout=aiohttp.ClientTimeout(total=OPENAI_FILES_API_TIMEOUT),
+    ) as r:
+        if r.status >= 400:
+            raise ValueError(f'Files API upload of {file.filename} failed ({r.status}): {await r.text()}')
+        file_id = (await r.json()).get('id')
+    if not isinstance(file_id, str) or not file_id:
+        raise ValueError(f'Files API upload of {file.filename} returned no file ID')
+
+    await Files.update_file_metadata_by_id(file.id, {'openai_file_id': file_id})
+    return file_id
+
+
+async def get_loader_args(request, user, file_id: str | None) -> dict | None:
+    """OpenAIFilesLoader arguments for an Open WebUI file, or None to use the default loaders."""
+    if not (is_enabled() and request is not None and file_id):
+        return None
+    file = await Files.get_file_by_id(file_id)
+    if file is None or not file.path:
+        return None
+    return {
+        'base_url': OPENAI_FILES_API_BASE_URL,
+        'file_id': await get_openai_file_id(request, user, file),
+        'headers': await get_request_headers(request, user),
+        'params': OPENAI_FILES_API_PARAMS,
+        'timeout': OPENAI_FILES_API_TIMEOUT,
+    }
+
+
+async def _is_sendable_document(file, user) -> bool:
+    """A stored document the user can read; images keep their image_url parts, audio and video their transcripts."""
+    content_type = ((file.meta or {}).get('content_type') or '').split(';')[0].strip().lower()
+    return (
+        bool(file.path)
+        and not (is_raster_image_content_type(content_type) or content_type.startswith(('audio/', 'video/')))
+        and (file.user_id == user.id or user.role == 'admin' or await has_access_to_file(file.id, 'read', user))
+    )
+
+
+async def add_file_id_parts(request, form_data: dict, metadata: dict, user, model: dict) -> None:
+    """Send a matching model each user message's documents as file parts.
+
+    Retrieval and the builtin file tools leave these documents out, as they do for a Filter's
+    file_handler. A document that cannot be uploaded keeps Open WebUI's usual handling.
+    """
+    if not is_file_id_model(model):
+        return
+
+    messages = list(form_data.get('messages', []))
+    attached = {
+        index: list(
+            dict.fromkeys(
+                item['id']
+                for item in message.get('files') or []
+                if isinstance(item, dict) and item.get('type', 'file') == 'file' and item.get('id')
+            )
+        )
+        for index, message in enumerate(messages)
+        if message.get('role') == 'user'
+    }
+    ids = list(dict.fromkeys(id for message_ids in attached.values() for id in message_ids))
+    files = await Files.get_files_by_ids(ids) if ids else []
+
+    # Resolve each document once, even when several messages attach it.
+    openai_file_ids = {}
+    for file in files:
+        if not await _is_sendable_document(file, user):
+            continue
+        try:
+            openai_file_ids[file.id] = await get_openai_file_id(request, user, file)
+        except Exception as e:
+            log.warning(f'{file.filename} ({file.id}) keeps Open WebUI file handling: {e}')
+    if not openai_file_ids:
+        return
+
+    filenames = {file.id: file.filename for file in files}
+    for index, message_ids in attached.items():
+        sent = [id for id in message_ids if id in openai_file_ids]
+        if not sent:
+            continue
+        message = messages[index]
+        content = message.get('content') or ''
+        if isinstance(content, str):
+            content = [{'type': 'text', 'text': content}] if content else []
+        parts = [{'type': 'file', 'file': {'file_id': openai_file_ids[id], 'filename': filenames[id]}} for id in sent]
+        # New dicts: compaction may still summarize the original messages with the task model.
+        messages[index] = {
+            **message,
+            'content': [*content, *parts],
+            'files': [item for item in message['files'] if not (isinstance(item, dict) and item.get('id') in sent)],
+        }
+    form_data['messages'] = messages
+
+    # process_chat_payload later restores metadata['files'] from form_data['files'].
+    for holder in (metadata, form_data):
+        if holder.get('files'):
+            holder['files'] = [
+                item for item in holder['files'] if not (isinstance(item, dict) and item.get('id') in openai_file_ids)
+            ]
