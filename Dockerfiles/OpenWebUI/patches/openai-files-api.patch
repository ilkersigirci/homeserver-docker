+++ b/open_webui/utils/openai_files.py
@@ -0,0 +1,280 @@
+"""Chat documents and images in an OpenAI-compatible Files API (homeserver openai-files-api.patch).
+
+A model matching OPENAI_FILES_API_MODELS_REGEX_PATTERN receives each user message's documents
+with an OPENAI_FILES_API_FILE_EXTENSIONS extension as standard file parts, and its stored
+images as Responses input_image parts, both by Files API file ID. CONTENT_EXTRACTION_ENGINE=
+openai_files takes those documents' text from files-api's extraction. Both need
+OPENAI_FILES_API_BASE_URL. Other files keep Open WebUI's handling. A file is uploaded once; its
+meta keeps the Files API ID for later requests.
+"""
+
+import asyncio
+import logging
+import os
+import re
+from pathlib import Path
+
+import httpx
+from langchain_core.document_loaders import BaseLoader
+from langchain_core.documents import Document
+from open_webui.env import AIOHTTP_CLIENT_SESSION_SSL, ENABLE_FORWARD_USER_INFO_HEADERS
+from open_webui.models.files import Files
+from open_webui.storage.provider import Storage
+from open_webui.utils.access_control.files import has_access_to_file
+from open_webui.utils.files import FILE_CONTENT_URL_PATTERN
+from open_webui.utils.headers import include_user_info_headers
+from open_webui.utils.json_codec import JSONCodec
+from open_webui.utils.misc import is_raster_image_content_type
+from openai import DEFAULT_TIMEOUT, AsyncOpenAI, DefaultAsyncHttpxClient
+
+log = logging.getLogger(__name__)
+
+OPENAI_FILES_API_BASE_URL = os.getenv('OPENAI_FILES_API_BASE_URL', '').rstrip('/')
+OPENAI_FILES_API_KEY = os.getenv('OPENAI_FILES_API_KEY', '')
+try:
+    OPENAI_FILES_API_PARAMS = JSONCodec.loads(os.getenv('OPENAI_FILES_API_PARAMS') or '{}')
+    if not isinstance(OPENAI_FILES_API_PARAMS, dict):
+        raise ValueError('expected a JSON object')
+except Exception as e:
+    log.exception(f'Error loading OPENAI_FILES_API_PARAMS: {e}')
+    OPENAI_FILES_API_PARAMS = {}
+try:
+    OPENAI_FILES_API_TIMEOUT = int(os.getenv('OPENAI_FILES_API_TIMEOUT') or 300)
+except ValueError:
+    OPENAI_FILES_API_TIMEOUT = 300
+# The document types files-api extracts; others keep Open WebUI's handling, as upstream's
+# MINERU_FILE_EXTENSIONS does for its mineru engine. Extend it as files-api extracts more types.
+OPENAI_FILES_API_FILE_EXTENSIONS = [
+    ext.strip().lower()
+    for ext in os.getenv('OPENAI_FILES_API_FILE_EXTENSIONS', 'pdf,docx,doc,pptx,ppt,xlsx,xls').split(',')
+    if ext.strip()
+]
+# Compiled once. Unset, invalid, or without a base URL, it matches nothing ('(?!)'), so a
+# bad setting turns file IDs off instead of failing every chat.
+try:
+    OPENAI_FILES_API_MODELS_REGEX = re.compile(os.getenv('OPENAI_FILES_API_MODELS_REGEX_PATTERN') or '(?!)')
+    if os.getenv('OPENAI_FILES_API_MODELS_REGEX_PATTERN') and not OPENAI_FILES_API_BASE_URL:
+        raise ValueError('it needs OPENAI_FILES_API_BASE_URL')
+except (re.error, ValueError) as e:
+    log.exception(f'Error loading OPENAI_FILES_API_MODELS_REGEX_PATTERN: {e}')
+    OPENAI_FILES_API_MODELS_REGEX = re.compile('(?!)')
+# Seconds between status checks while the Files API extracts a document's text.
+PROCESSING_POLL_SECONDS = 2
+
+
+def is_files_api_type(filename: str) -> bool:
+    return filename.split('.')[-1].lower() in OPENAI_FILES_API_FILE_EXTENSIONS
+
+
+def is_file_id_model(model: dict) -> bool:
+    """The model, or a workspace model's base model, reads documents by Files API file ID."""
+    model_ids = (model.get('id'), (model.get('info') or {}).get('base_model_id'))
+    return any(OPENAI_FILES_API_MODELS_REGEX.match(model_id) for model_id in model_ids if model_id)
+
+
+async def get_client(request, user) -> AsyncOpenAI:
+    """A Files API client that authenticates like the OpenAI connection with the same base URL."""
+    # Defined by speech-images-system-oauth.patch.
+    from open_webui.routers.openai import get_connection_api_key
+
+    headers = include_user_info_headers({}, user, request=request) if ENABLE_FORWARD_USER_INFO_HEADERS else {}
+    return AsyncOpenAI(
+        api_key=await get_connection_api_key(request, user, OPENAI_FILES_API_BASE_URL, OPENAI_FILES_API_KEY),
+        base_url=OPENAI_FILES_API_BASE_URL,
+        default_headers=headers,
+        default_query=OPENAI_FILES_API_PARAMS,
+        # The SDK's connect timeout, so an unreachable Files API fails fast on each retry.
+        timeout=httpx.Timeout(OPENAI_FILES_API_TIMEOUT, connect=DEFAULT_TIMEOUT.connect),
+        http_client=DefaultAsyncHttpxClient(verify=AIOHTTP_CLIENT_SESSION_SSL),
+    )
+
+
+async def get_openai_file_id(client: AsyncOpenAI, file, local_path: str | None = None) -> str:
+    """Return the file's Files API ID, uploading the file on first use, from local_path when already downloaded."""
+    if file_id := (file.meta or {}).get('openai_file_id'):
+        return file_id
+    local_path = local_path or await asyncio.to_thread(Storage.get_file, file.path)
+    # The SDK reads a path only as the whole file argument, which would name the upload after the stored file.
+    content = await asyncio.to_thread(Path(local_path).read_bytes)
+    content_type = (file.meta or {}).get('content_type') or 'application/octet-stream'
+    uploaded = await client.files.create(file=(file.filename, content, content_type), purpose='user_data')
+    await Files.update_file_metadata_by_id(file.id, {'openai_file_id': uploaded.id})
+    return uploaded.id
+
+
+def extracted_text(content: dict) -> str:
+    """files-api's extracted content as text, by its type: a text file's text, a
+    spreadsheet's row chunks, or, untyped, a parsed document's markdown results.
+
+    Another type fails, so content from a new files-api engine is never stored empty.
+    """
+    content_type = content.get('type')
+    if content_type == 'text':
+        return content['text']
+    if content_type == 'spreadsheet':
+        return '\n\n'.join(chunk for sheet in content['sheets'] for chunk in sheet['chunks'])
+    if content_type is None:
+        return '\n\n'.join(result['md_content'] for result in content.get('results') or [] if result.get('md_content'))
+    raise ValueError(f'The Files API returned {content_type} content, which Open WebUI cannot read yet')
+
+
+class OpenAIFilesLoader(BaseLoader):
+    """The text the Files API extracted, which Loader.load post-processes like any engine's."""
+
+    def __init__(self, text: str, file_id: str) -> None:
+        self.text = text
+        self.file_id = file_id
+
+    def load(self) -> list[Document]:
+        return [Document(page_content=self.text, metadata={'openai_file_id': self.file_id})]
+
+
+async def get_loader(request, user, file_id: str | None, filename: str, file_path: str) -> OpenAIFilesLoader | None:
+    """A loader with the Open WebUI file's extracted text, or None to use the built-in loaders.
+
+    file_path is the file's local copy, which processing has already downloaded.
+    """
+    if request is None or not file_id or not is_files_api_type(filename):
+        return None
+    if not OPENAI_FILES_API_BASE_URL:
+        # The engine is runtime config, so its base URL is checked where it is used.
+        raise ValueError('CONTENT_EXTRACTION_ENGINE=openai_files needs OPENAI_FILES_API_BASE_URL')
+    file = await Files.get_file_by_id(file_id)
+    if file is None or not file.path:
+        return None
+    async with await get_client(request, user) as client:
+        openai_file_id = await get_openai_file_id(client, file, file_path)
+        processed = await client.files.wait_for_processing(
+            openai_file_id, poll_interval=PROCESSING_POLL_SECONDS, max_wait_seconds=OPENAI_FILES_API_TIMEOUT
+        )
+        if processed.status == 'error':
+            raise ValueError(f'Files API text extraction failed: {processed.status_details or "no details"}')
+        content = (await client.files.content(openai_file_id)).json()
+    return OpenAIFilesLoader(extracted_text(content), openai_file_id)
+
+
+def _content_type(file) -> str:
+    return ((file.meta or {}).get('content_type') or '').split(';')[0].strip().lower()
+
+
+def _is_image(file) -> bool:
+    return is_raster_image_content_type(_content_type(file))
+
+
+def _is_document(file) -> bool:
+    """A document of a type the Files API extracts.
+
+    Audio and video keep their transcripts, and other files the text Open WebUI extracts, which a
+    model reading file IDs could not read from the Files API.
+    """
+    return is_files_api_type(file.filename) and not (
+        _is_image(file) or _content_type(file).startswith(('audio/', 'video/'))
+    )
+
+
+async def _can_read(file, user) -> bool:
+    """A stored file the user can read, as Open WebUI checks before it inlines an image."""
+    return bool(file.path) and (
+        file.user_id == user.id or user.role == 'admin' or await has_access_to_file(file.id, 'read', user)
+    )
+
+
+def _shown_file_id(part) -> str | None:
+    """The stored file an image_url part shows: a file ID or its content URL, as
+    get_image_base64_from_url resolves it, never a data or web URL."""
+    image = part.get('image_url') if isinstance(part, dict) and part.get('type') == 'image_url' else None
+    url = image.get('url') if isinstance(image, dict) else image
+    if not isinstance(url, str) or not url or url.startswith(('data:', 'http')):
+        return None
+    match = FILE_CONTENT_URL_PATTERN.match(url)
+    return match.group(1) if match else url
+
+
+def _input_image(part: dict, file_id: str) -> dict:
+    """The image part by Files API ID, with its detail."""
+    image = part['image_url']
+    detail = image.get('detail') if isinstance(image, dict) else None
+    return {'type': 'input_image', 'file_id': file_id, 'detail': detail or 'auto'}
+
+
+async def add_file_id_parts(request, form_data: dict, metadata: dict, user, model: dict) -> None:
+    """Send a matching model, by Files API file ID, each user message's documents as file parts
+    and the stored images it shows as input_image parts.
+
+    Retrieval, the builtin file tools, and the attached files list leave these files out, as they
+    do for a Filter's file_handler. A file that cannot be uploaded keeps Open WebUI's usual handling.
+    """
+    if not is_file_id_model(model):
+        return
+
+    messages = list(form_data.get('messages', []))
+    # A user message lists its documents in files and shows its images as image_url parts.
+    attached, shown = {}, {}
+    for index, message in enumerate(messages):
+        if message.get('role') == 'user':
+            attached[index] = list(
+                dict.fromkeys(
+                    item['id']
+                    for item in message.get('files') or []
+                    if isinstance(item, dict) and item.get('type', 'file') == 'file' and item.get('id')
+                )
+            )
+            content = message.get('content')
+            shown[index] = [id for part in content if (id := _shown_file_id(part))] if isinstance(content, list) else []
+    documents = {id for message_ids in attached.values() for id in message_ids}
+    images = {id for message_ids in shown.values() for id in message_ids}
+    ids = list(dict.fromkeys(id for message_ids in (*attached.values(), *shown.values()) for id in message_ids))
+    files = await Files.get_files_by_ids(ids) if ids else []
+    files = [
+        file
+        for file in files
+        if ((file.id in documents and _is_document(file)) or (file.id in images and _is_image(file)))
+        and await _can_read(file, user)
+    ]
+    if not files:
+        return
+
+    # Resolve each file once, even when several messages attach it.
+    openai_file_ids = {}
+    async with await get_client(request, user) as client:
+        for file in files:
+            try:
+                openai_file_ids[file.id] = await get_openai_file_id(client, file)
+            except Exception as e:
+                log.warning(f'{file.filename} ({file.id}) keeps Open WebUI file handling: {e}')
+    if not openai_file_ids:
+        return
+
+    filenames = {file.id: file.filename for file in files}
+    sent_images = {file.id for file in files if _is_image(file) and file.id in openai_file_ids}
+    for index, message_ids in attached.items():
+        sent_documents = [id for id in message_ids if id in openai_file_ids and id not in sent_images]
+        sent = {*sent_documents, *sent_images.intersection(shown[index])}
+        if not sent:
+            continue
+        message = messages[index]
+        content = message.get('content') or ''
+        if isinstance(content, str):
+            content = [{'type': 'text', 'text': content}] if content else []
+        content = [
+            _input_image(part, openai_file_ids[id]) if (id := _shown_file_id(part)) in sent_images else part
+            for part in content
+        ]
+        parts = [
+            {'type': 'file', 'file': {'file_id': openai_file_ids[id], 'filename': filenames[id]}}
+            for id in sent_documents
+        ]
+        # New dicts: compaction may still summarize the original messages with the task model.
+        messages[index] = {**message, 'content': [*content, *parts]}
+        if message.get('files'):
+            messages[index]['files'] = [
+                item for item in message['files'] if not (isinstance(item, dict) and item.get('id') in sent)
+            ]
+    form_data['messages'] = messages
+
+    # process_chat_payload later restores metadata['files'] from form_data['files'].
+    for holder in (metadata, form_data):
+        if holder.get('files'):
+            holder['files'] = [
+                item for item in holder['files'] if not (isinstance(item, dict) and item.get('id') in openai_file_ids)
+            ]
