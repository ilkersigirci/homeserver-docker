+"""Extracted text from an OpenAI-compatible Files API (homeserver openai-files-api.patch)."""
+
+from urllib.parse import quote
+
+import requests
+from langchain_core.document_loaders import BaseLoader
+from langchain_core.documents import Document
+from open_webui.env import REQUESTS_VERIFY
+
+TEXT_CONTENT_TYPES = ('text/markdown', 'text/x-markdown', 'text/plain')
+
+
+class OpenAIFilesLoader(BaseLoader):
+    """Read GET /files/{file_id}/content?format=markdown; without format, the API returns the original bytes."""
+
+    def __init__(self, base_url: str, file_id: str, headers: dict, params: dict, timeout: int) -> None:
+        self.url = f'{base_url}/files/{quote(file_id, safe="")}/content'
+        self.file_id = file_id
+        self.headers = headers
+        self.params = {**params, 'format': 'markdown'}
+        self.timeout = timeout
+
+    def load(self) -> list[Document]:
+        # Connecting should be quick; extraction may take most of the timeout.
+        response = requests.get(
+            self.url, params=self.params, headers=self.headers, timeout=(10, self.timeout), verify=REQUESTS_VERIFY
+        )
+        if not response.ok:
+            raise ValueError(f'Files API text extraction failed ({response.status_code}): {response.text}')
+        content_type = response.headers.get('Content-Type', '').lower()
+        if content_type.split(';')[0].strip() not in TEXT_CONTENT_TYPES:
+            raise ValueError(f'The Files API returned {content_type or "no content type"} instead of extracted text')
+        if 'charset=' not in content_type:
+            # requests assumes ISO-8859-1 for text without a charset.
+            response.encoding = 'utf-8'
+        return [Document(page_content=response.text, metadata={'openai_file_id': self.file_id})]
