Upstream gap: Open WebUI's OpenAI speech and image settings take only a static
key, so speech-to-text, text-to-speech, image generation, and image editing
cannot send the signed-in user's OAuth token (requested in open-webui#21281;
open-webui#21282 was closed unmerged).

Authenticate each of them like the OpenAI connection with the same base URL:
when that connection's auth_type is system_oauth, send the user's OAuth token
instead of the configured key. Other connection settings, such as custom
headers, still apply to chat only.

Removal check: an Open WebUI release with an auth type for OpenAI speech and
image requests.

--- a/open_webui/routers/openai.py
+++ b/open_webui/routers/openai.py
@@ -343,6 +343,21 @@
     return url, key, api_config


+async def get_connection_api_key(request, user, base_url: str, api_key: str) -> str:
+    """Authenticate like the OpenAI connection with this base URL: its system_oauth sends the user's token."""
+    _, api_base_urls, _, api_configs = await get_openai_runtime_config()
+    for idx, url in enumerate(api_base_urls):
+        if url.rstrip('/') != base_url.rstrip('/'):
+            continue
+        if api_configs.get(str(idx), api_configs.get(url, {})).get('auth_type') != 'system_oauth':
+            break
+        from open_webui.utils.middleware import get_system_oauth_token
+
+        oauth_token = await get_system_oauth_token(request, user) if user else None
+        return (oauth_token or {}).get('access_token', '')
+    return api_key
+
+
