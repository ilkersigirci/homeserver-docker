@@ -258,4 +258,29 @@ func (store *UserSessionStore) Save(r *http.Request, w http.ResponseWriter, sess
 }

+// Renew persists a session under a fresh identifier and removes the previous
+// database row. Use this when an unauthenticated session becomes authenticated
+// so a pre-login session identifier cannot be fixed by an attacker.
+func (store *UserSessionStore) Renew(r *http.Request, w http.ResponseWriter, session *sessions.Session) error {
+	oldID := session.ID
+	oldUUID, err := uuid.Parse(oldID)
+	if err == nil {
+		if _, err := store.repo.Delete(r.Context(), oldUUID); err != nil && !errors.Is(err, pgx.ErrNoRows) {
+			return fmt.Errorf("could not delete previous user session during renewal: %w", err)
+		}
+	} else if oldID != "" {
+		return fmt.Errorf("invalid previous session ID during renewal: %w", err)
+	}
+
+	session.ID = uuid.NewString()
+	session.IsNew = true
+
+	if err := store.Save(r, w, session); err != nil {
+		session.ID = oldID
+		return err
+	}
+
+	return nil
+}
+
 // save writes encoded session.Values to a database record.
 // writes to http_sessions table by default.
