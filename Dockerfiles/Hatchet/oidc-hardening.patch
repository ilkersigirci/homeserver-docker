+const getUserByOAuthIdentity = `-- name: GetUserByOAuthIdentity :one
+SELECT
+    "User".id, "User"."createdAt", "User"."updatedAt", "User"."deletedAt", "User".email, "User"."emailVerified", "User".name
+FROM
+    "User"
+JOIN
+    "UserOAuth" ON "UserOAuth"."userId" = "User"."id"
+WHERE
+    "UserOAuth"."provider" = $1::text
+    AND "UserOAuth"."providerUserId" = $2::text
+`
+
+type GetUserByOAuthIdentityParams struct {
+	Provider       string `json:"provider"`
+	Provideruserid string `json:"provideruserid"`
+}
+
+func (q *Queries) GetUserByOAuthIdentity(ctx context.Context, db DBTX, arg GetUserByOAuthIdentityParams) (*User, error) {
+	row := db.QueryRow(ctx, getUserByOAuthIdentity, arg.Provider, arg.Provideruserid)
+	var i User
+	err := row.Scan(
+		&i.ID,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+		&i.DeletedAt,
+		&i.Email,
+		&i.EmailVerified,
+		&i.Name,
+	)
+	return &i, err
+}
