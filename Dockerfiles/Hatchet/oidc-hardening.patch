+func newOIDCOAuthOpts(config *server.ServerConfig, providerUserID string) (*v1.OAuthOpts, error) {
+	// Hatchet's shared OAuth table requires an access-token value, but OIDC is
+	// used only for authentication here. Persist a non-secret marker instead of
+	// retaining access or refresh tokens that the application never consumes.
+	marker, err := config.Encryption.Encrypt([]byte("oidc-token-not-stored"), "oidc_access_token")
+	if err != nil {
+		return nil, fmt.Errorf("failed to encrypt OIDC token marker: %w", err)
+	}
+
+	return &v1.OAuthOpts{
+		Provider:       "oidc",
+		ProviderUserId: providerUserID,
+		AccessToken:    marker,
+	}, nil
+}
+
+func oidcProviderUserID(issuer, subject string) string {
+	digest := sha256.Sum256([]byte(issuer + "\x00" + subject))
+	return "v1." + base64.RawURLEncoding.EncodeToString(digest[:])
+}
+
+func optionalString(value string) *string {
+	if value == "" {
+		return nil
+	}
+
+	return v1.StringPtr(value)
+}
