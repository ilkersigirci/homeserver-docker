{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": [
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "npm",
    "pep621"
  ],
  "includePaths": [
    "apps/**",
    "compose/fragments/**",
    "Dockerfiles/**",
    ".github/workflows/**"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 10-16 * * 1-5"],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 10,
  "commitHourlyLimit": 2,
  "docker-compose": {
    "managerFilePatterns": ["/^(?:apps|compose\\/fragments)\\/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfiles/ProxmoxBackupClient/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG IMAGE_VERSION=(?<currentValue>\\S+)"
      ],
      "registryUrlTemplate": "http://download.proxmox.com/debian/pbs-client?suite=trixie&components=test&binaryArch=arm64",
      "versioningTemplate": "deb"
    }
  ],
  "packageRules": [
    {
      "description": "Update and pin versioned homeserver images",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["/^ghcr\\.io\\/ilkersigirci\\/homeserver-/"],
      "groupName": "homeserver custom images",
      "groupSlug": "homeserver-custom-images",
      "pinDigests": true
    },
    {
      "description": "Disable non-release-driver updates for package-derived custom images",
      "matchFileNames": [
        "Dockerfiles/CodexAcp/**",
        "Dockerfiles/Jupyter/**",
        "Dockerfiles/Marimo/**",
        "Dockerfiles/ProxmoxBackupClient/**"
      ],
      "enabled": false
    },
    {
      "description": "Use Codex ACP as the Codex ACP custom image release driver",
      "matchManagers": ["npm"],
      "matchDatasources": ["npm"],
      "matchFileNames": ["Dockerfiles/CodexAcp/package.json"],
      "matchPackageNames": ["@agentclientprotocol/codex-acp"],
      "enabled": true,
      "sourceUrl": "https://github.com/agentclientprotocol/codex-acp",
      "changelogUrl": "https://github.com/agentclientprotocol/codex-acp/releases"
    },
    {
      "description": "Ignore non-final images in the Gatus Dockerfile",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfiles/Gatus/Dockerfile"],
      "matchDepTypes": ["stage", "syntax"],
      "enabled": false
    },
    {
      "description": "Track Gatus releases only",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/ilkersigirci/homeserver-gatus",
        "ghcr.io/twin/gatus"
      ],
      "sourceUrl": "https://github.com/TwiN/gatus",
      "changelogUrl": "https://github.com/TwiN/gatus/releases",
      "digest": {
        "enabled": false
      }
    },
    {
      "description": "Use JupyterLab as the Jupyter custom image release driver",
      "matchManagers": ["pep621"],
      "matchDatasources": ["pypi"],
      "matchFileNames": ["Dockerfiles/Jupyter/pyproject.toml"],
      "matchPackageNames": ["jupyterlab"],
      "enabled": true,
      "sourceUrl": "https://github.com/jupyterlab/jupyterlab",
      "changelogUrl": "https://github.com/jupyterlab/jupyterlab/releases"
    },
    {
      "description": "Ignore non-final images in the LiteLLM Dockerfile",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfiles/LiteLLM/Dockerfile"],
      "matchDepTypes": ["stage", "syntax"],
      "enabled": false
    },
    {
      "description": "Track LiteLLM Libre releases only",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/ilkersigirci/homeserver-litellm",
        "ghcr.io/nathanael-h/litellm-libre"
      ],
      "sourceUrl": "https://github.com/nathanael-h/litellm-libre",
      "changelogUrl": "https://github.com/nathanael-h/litellm-libre/releases",
      "digest": {
        "enabled": false
      }
    },
    {
      "description": "Use Marimo as the Marimo custom image release driver",
      "matchManagers": ["pep621"],
      "matchDatasources": ["pypi"],
      "matchFileNames": ["Dockerfiles/Marimo/pyproject.toml"],
      "matchPackageNames": ["marimo"],
      "enabled": true,
      "sourceUrl": "https://github.com/marimo-team/marimo",
      "changelogUrl": "https://github.com/marimo-team/marimo/releases"
    },
    {
      "description": "Use Proxmox Backup Client as the Proxmox Backup Client custom image release driver",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["deb"],
      "matchFileNames": ["Dockerfiles/ProxmoxBackupClient/Dockerfile"],
      "matchPackageNames": ["proxmox-backup-client"],
      "enabled": true,
      "sourceUrl": "https://git.proxmox.com/?p=proxmox-backup.git;a=summary"
    },
    {
      "description": "Disable standalone lock-file maintenance for package-derived custom images",
      "matchManagers": ["npm", "pep621"],
      "matchFileNames": [
        "Dockerfiles/CodexAcp/package.json",
        "Dockerfiles/CodexAcp/package-lock.json",
        "Dockerfiles/Jupyter/pyproject.toml",
        "Dockerfiles/Jupyter/uv.lock",
        "Dockerfiles/Marimo/pyproject.toml",
        "Dockerfiles/Marimo/uv.lock"
      ],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "description": "Use Codex ACP GitHub releases for homeserver Codex ACP image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/marimo.yml"],
      "matchPackageNames": ["ghcr.io/ilkersigirci/homeserver-codex-acp"],
      "sourceUrl": "https://github.com/agentclientprotocol/codex-acp",
      "changelogUrl": "https://github.com/agentclientprotocol/codex-acp/releases"
    },
    {
      "description": "Use JupyterLab GitHub releases for homeserver Jupyter image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/jupyterlab.yml"],
      "matchPackageNames": ["ghcr.io/ilkersigirci/homeserver-jupyter"],
      "sourceUrl": "https://github.com/jupyterlab/jupyterlab",
      "changelogUrl": "https://github.com/jupyterlab/jupyterlab/releases"
    },
    {
      "description": "Use LiteLLM Libre GitHub releases for homeserver LiteLLM image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/litellm.yml"],
      "matchPackageNames": ["ghcr.io/ilkersigirci/homeserver-litellm"],
      "sourceUrl": "https://github.com/nathanael-h/litellm-libre",
      "changelogUrl": "https://github.com/nathanael-h/litellm-libre/releases"
    },
    {
      "description": "Use Marimo GitHub releases for homeserver Marimo image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/marimo.yml"],
      "matchPackageNames": ["ghcr.io/ilkersigirci/homeserver-marimo"],
      "sourceUrl": "https://github.com/marimo-team/marimo",
      "changelogUrl": "https://github.com/marimo-team/marimo/releases"
    },
    {
      "description": "Use Proxmox Backup Client releases for homeserver Proxmox Backup Client image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/pbs-client-hs.yml"],
      "matchPackageNames": [
        "ghcr.io/ilkersigirci/homeserver-proxmox-backup-client"
      ],
      "sourceUrl": "https://git.proxmox.com/?p=proxmox-backup.git;a=summary"
    },
    {
      "description": "Group Arcane server and agent Docker image updates",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "apps/arcane.yml",
        "apps/arcane-agent.yml",
        "apps/arcane-agent-gpu.yml"
      ],
      "matchPackageNames": [
        "ghcr.io/getarcaneapp/arcane",
        "ghcr.io/getarcaneapp/arcane-headless"
      ],
      "groupName": "Arcane"
    },
    {
      "description": "Use GitHub releases for Bambubuddy Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/maziggy/bambuddy"],
      "sourceUrl": "https://github.com/maziggy/bambuddy"
    },
    {
      "description": "Use GitHub releases for Bichon Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rustmailer/bichon"],
      "sourceUrl": "https://github.com/rustmailer/bichon"
    },
    {
      "description": "Use Bifrost transport GitHub releases for Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["maximhq/bifrost"],
      "sourceUrl": "https://github.com/maximhq/bifrost",
      "extractVersion": "^(?:transports/)?(?<version>v?\\d+\\.\\d+\\.\\d+(?:-prerelease\\d+)?)$"
    },
    {
      "description": "Use GitHub releases for ExcaliDash Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "zimengxiong/excalidash-backend",
        "zimengxiong/excalidash-frontend"
      ],
      "sourceUrl": "https://github.com/ZimengXiong/ExcaliDash"
    },
    {
      "description": "Use GitHub releases for FileBrowser Quantum Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/gtsteffaniak/filebrowser"],
      "versionCompatibility": "^(?<version>\\d+\\.\\d+\\.\\d+)(?<compatibility>-stable)$",
      "versioning": "semver",
      "sourceUrl": "https://github.com/gtsteffaniak/filebrowser"
    },
    {
      "description": "Use GitHub releases for Glance Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["glanceapp/glance"],
      "sourceUrl": "https://github.com/glanceapp/glance"
    },
    {
      "description": "Disable Python image updates for the Gatus container health adapter",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/gatus-container-health.yml"],
      "matchPackageNames": ["python"],
      "enabled": false
    },
    {
      "description": "Use GitHub releases for Hatchet Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/hatchet-dev/hatchet/hatchet-lite"],
      "sourceUrl": "https://github.com/hatchet-dev/hatchet"
    },
    {
      "description": "Use GitHub releases for Headscale Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/juanfont/headscale"],
      "sourceUrl": "https://github.com/juanfont/headscale"
    },
    {
      "description": "Disable Renovate updates for Immich Redis and PostgreSQL images",
      "matchFileNames": ["apps/immich.yml"],
      "matchPackageNames": [
        "docker.io/valkey/valkey",
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "description": "Use GitHub releases for Jellyfin Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/jellyfin/jellyfin"],
      "versioning": "semver",
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "description": "Use GitHub releases for Kiwix Serve Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/kiwix/kiwix-serve"],
      "sourceUrl": "https://github.com/kiwix/kiwix-tools"
    },
    {
      "description": "Group Langfuse web and worker Docker image updates",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/langfuse.yml"],
      "matchPackageNames": ["langfuse/langfuse", "langfuse/langfuse-worker"],
      "groupName": "Langfuse"
    },
    {
      "description": "Track LinuxServer application and image build versions",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/^(?:(?:docker\\.io|ghcr\\.io|lscr\\.io)\\/)?linuxserver\\//"
      ],
      "matchCurrentValue": "/^v?\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?(?:-r?\\d+)?-ls\\d+$/",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:-r?\\d+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Disable Meilisearch updates that are version-coupled to Karakeep and Jellyfin",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["apps/karakeep.yml", "apps/jellyfin.yml"],
      "matchPackageNames": ["getmeili/meilisearch"],
      "enabled": false
    },
    {
      "description": "Use GitHub releases for Presenton Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/presenton/presenton"],
      "sourceUrl": "https://github.com/presenton/presenton"
    },
    {
      "description": "Use GitHub releases for RabbitMQ Docker image changelogs",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rabbitmq"],
      "sourceUrl": "https://github.com/rabbitmq/rabbitmq-server"
    },
    {
      "description": "Group Rybbit backend and client Docker image updates",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["apps/rybbit.yml"],
      "matchPackageNames": [
        "ghcr.io/rybbit-io/rybbit-backend",
        "ghcr.io/rybbit-io/rybbit-client"
      ],
      "groupName": "Rybbit"
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "labels": ["dependencies", "docker", "renovate"]
}
