{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["docker-compose", "github-actions"],
  "includePaths": ["apps/**", ".github/workflows/**"],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 10-16 * * 1-5"],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 10,
  "commitHourlyLimit": 2,
  "docker-compose": {
    "managerFilePatterns": ["/^apps\\/.*\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Disable Renovate updates for all images in Immich compose files by default",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["apps/immich*.yml"],
      "enabled": false
    },
    {
      "description": "Allow only Immich app and machine-learning images to update",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["apps/immich*.yml"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "enabled": true
    },
    {
      "description": "Disable Meilisearch updates that are version-coupled to Karakeep and Jellyfin",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["apps/karakeep.yml", "apps/jellyfin.yml"],
      "matchPackageNames": ["getmeili/meilisearch"],
      "enabled": false
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "labels": ["dependencies", "docker", "renovate"]
}
