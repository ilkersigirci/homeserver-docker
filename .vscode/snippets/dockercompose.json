{
  "Docker Service Template": {
    "prefix": "dockerservice",
    "description": "Create a new Docker service configuration with Traefik labels",
    "body": [
      "${1:servicename}:",
      "  image: ${2:image}:${3:latest}",
      "  container_name: ${1:servicename}",
      "  restart: \\$RESTART_POLICY_OTHERS",
      "  profiles:",
      "    - ${7:group}",
      "  networks:",
      "    - t3_proxy",
      "  expose:",
      "    - ${5:80}",
      "  ports:",
      "    - \"${6:8080}:${5:80}\"",
      "  user: \\$PUID:\\$PGID",
      "  read_only: true",
      "  tmpfs:",
      "    - /tmp:rw,noexec,nosuid,nodev,size=64m,uid=\\$PUID,gid=\\$PGID,mode=1777",
      "  security_opt:",
      "    - no-new-privileges:true",
      "  cap_drop:",
      "    - ALL",
      "  cap_add: []",
      "  pids_limit: 256",
      "  cpus: \"1.0\"",
      "  mem_limit: \"1G\"",
      "  ulimits:",
      "    nofile:",
      "      soft: 4096",
      "      hard: 8192",
      "  volumes:",
      "    - \\$REPO_PATH/data/${1:servicename}:${4:/data/}",
      "  environment:",
      "    PUID: \\$PUID",
      "    PGID: \\$PGID",
      "    TZ: \\$TZ",
      "  healthcheck:",
      "    disable: true",
      "  labels:",
      "    traefik.enable: \"true\"",
      "    ## HTTP Routers",
      "    traefik.http.routers.${1:servicename}-rtr.entrypoints: \"websecure\"",
      "    traefik.http.routers.${1:servicename}-rtr.rule: \"Host(`${1:servicename}.\\$DOMAINNAME`)\"",
      "    ## Middlewares",
      "    traefik.http.routers.${1:servicename}-rtr.middlewares: \"chain-tinyauth@file\"",
      "    ## HTTP Services",
      "    traefik.http.routers.${1:servicename}-rtr.service: \"${1:servicename}-svc\"",
      "    traefik.http.services.${1:servicename}-svc.loadbalancer.server.port: \"${5:80}\"",
      "    ####### HOMEPAGE #######",
      "    homepage.group: \"${7:group}\"",
      "    homepage.name: \"${1:servicename}\"",
      "    homepage.icon: \"${1:servicename}.png\"",
      "    homepage.href: \"https://${1:servicename}.\\$DOMAINNAME\"",
      "    homepage.target: \"_blank\"",
      "    homepage.description: \"${8:description}\"",
      "    ####### GLANCE #######",
      "    glance.name: \"${1:servicename}\"",
      "    glance.icon: \"sh:${1:servicename}\"",
      "    glance.url: \"https://${1:servicename}.\\$DOMAINNAME\"",
      "    glance.description: \"${8:description}\""
    ]
  }
}
