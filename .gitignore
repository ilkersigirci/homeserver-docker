# General
acme.json
# Appdata (keep folder structure, ignore runtime files)
appdata/**
!appdata/
!appdata/**/
!appdata/**/.gitkeep
## Jellyfin bind mounts (track only folder placeholders)
!appdata/jellyfin/.gitkeep
!appdata/jellyfin/cache/.gitkeep
secrets
.idea
.env*
.github
node_modules

