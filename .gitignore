## CrowdSec (track only the important editable config files)
!configs/crowdsec/
!configs/crowdsec/config/
configs/crowdsec/config/**
!configs/crowdsec/config/acquis.yaml
!configs/crowdsec/config/config.yaml
!configs/crowdsec/config/profiles.yaml
!configs/crowdsec/config/console.yaml
!configs/crowdsec/config/user.yaml
!configs/crowdsec/config/notifications/
configs/crowdsec/config/notifications/**
!configs/crowdsec/config/notifications/victoriametrics.yaml
### Keep credentials out of git
configs/crowdsec/config/local_api_credentials.yaml
configs/crowdsec/config/online_api_credentials.yaml

# Data
data/**
!data/
!data/**/
!data/**/.gitkeep
## Jellyfin bind mounts (track only folder placeholders)
!data/jellyfin/.gitkeep
!data/jellyfin/metadata/.gitkeep
!data/downloads/.gitkeep

# Logs (keep folder structure, ignore runtime log files)
logs/**
!logs/
!logs/**/
!logs/**/.gitkeep

