# General
.codex
.env*
.agents/prompts
.idea
acme.json
node_modules
secrets

# Appdata
appdata/**
# Keep only top-level service directories discoverable; force-add deeper .gitkeep files.
!appdata/
!appdata/*/
!appdata/*/.gitkeep

# Backups
backups/**
!backups/.gitkeep

# Configs
configs/**
!configs/
!configs/**/
!configs/**/.gitkeep
!configs/litellm/config.yaml

## Keep credentials out of git
configs/headscale/oidc_client_secret
configs/crowdsec/config/local_api_credentials.yaml
configs/crowdsec/config/online_api_credentials.yaml

# Data
data/**
# Keep only top-level service directories discoverable; force-add deeper .gitkeep files.
!data/
!data/*/
!data/*/.gitkeep

# Logs (keep folder structure, ignore runtime log files)
logs/**
!logs/
!logs/**/
!logs/**/.gitkeep
